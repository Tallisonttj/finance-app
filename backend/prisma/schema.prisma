
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Profile {
  MEMBER
  ADMIN
  FAMILYADMIN
}
enum Status {
  PAGO
  PENDENTE
}
enum TipoConta {
  FAMILIAR
  INDIVIDUAL
}

model User{
   id String @db.VarChar(36) @id @default(uuid())
   name String
   cpf String @db.VarChar(11) @unique
   email String @unique
   password String 
   photo String?
   profile Profile @default(MEMBER)
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt
   Transaction Transaction[]
   @@map("Users")
}

model Transaction {
  id String @db.VarChar(10) @id @default(uuid())
  name String
  userId String
  user User @relation(fields: [userId], references: [id])
  categoryId String
  categoryName String
  category Category @relation(fields: [categoryId], references: [id])
  valor Decimal
  dtVencimento DateTime
  parcelaAtual Int @default(1)
  totalParcelas Int
  tipoConta TipoConta @default(INDIVIDUAL)
  status Status @default(PENDENTE)
  @@map("Transitions")
}
model Category {
  id String @db.VarChar(10) @id @default(uuid())
  descrition String
  Transaction Transaction[]


  @@map("Categories")
}
