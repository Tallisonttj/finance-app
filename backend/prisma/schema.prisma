
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Profile {
  MEMBER
  ADMIN
  FAMILYADMIN
}

model User{
   id String @db.VarChar(36) @id @default(uuid())
   name String
   cpf String @db.VarChar(11) @unique
   email String @unique
   password String // não sei como definir hash ainda, não estudei isso
   photo String?
   profile Profile @default(MEMBER)
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt
}
