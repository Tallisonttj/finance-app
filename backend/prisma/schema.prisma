
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Profile {
  MEMBER
  ADMIN
  FAMILYADMIN
}
enum Status {
  PAGO
  PENDENTE
}
enum TipoConta {
  FAMILIAR
  INDIVIDUAL
}

model User{
   id String @db.VarChar(36) @id @default(uuid())
   name String
   cpf String @db.VarChar(11) @unique
   email String @unique
   password String 
   photo String?
   profile Profile @default(MEMBER)
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt
   Tasks Task[]
   Transactions Transaction[]
   @@map("Users")
}

model Transaction {
  id String @db.VarChar(36) @id @default(uuid())
  transactionGruopID String @db.VarChar(36)
  name String
  userId String
  user User @relation(fields: [userId], references: [id])
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  responsavelDivida String
  total Decimal @db.Decimal(10,2)
  valorParcela Decimal @db.Decimal(10,2)
  dtVencimento DateTime 
  parcelaAtual Int @default(1)
  totalParcelas Int
  tipoConta TipoConta @default(INDIVIDUAL)
  status Status @default(PENDENTE)
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
  taskExecute TaskExecute[]
  @@map("Transitions")
}
model Category {
  id String @db.VarChar(36) @id @default(uuid())
  descrition String @unique
  Transactions Transaction[]
  Tasks Task[]
  @@map("Categories")
}
model Task {
  id String @db.VarChar(36) @id @default(uuid())
  descrition String @unique
  valor Decimal? @db.Decimal(10,2)
  interval Int 
  dtProxima DateTime
  dtUltima DateTime? 
  categoryId  String
  category   Category @relation(fields: [categoryId], references: [id])
  userId      String
  user        User @relation(fields: [userId], references: [id])
  taskExecute TaskExecute[]
  @@map("Tasks")
}
model TaskExecute {
  id Int @id @default(autoincrement())
  taskId String
  taskEx Task @relation(fields: [taskId], references: [id])
  valor Decimal? @db.Decimal(10,2)
  executeAt DateTime
  transactionId String?
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  @@map("TaskExecutions")
}
